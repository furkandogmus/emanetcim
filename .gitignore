# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
playwright-report/
test-results/

# next.js
/.next/
/out/

# production
/build

# Cursor / Claude yerel çalışma ağaçları (iç içe repo eklenmesin)
.claude/*
!.claude/commands/
!.claude/skills/

# i18n overlay build cache (scripts/build-locale-overlays.py)
scripts/.translate-cache.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Sunucuda kopyalanır; git clean -fd ile silinmesin diye ignore (örn. docker-compose.env.example → docker-compose.env)
docker-compose.env
# Yerel ops credential deposu (sunucu SSH bilgisi vb.) — ops/server.env.example şablonu git'te kalır
ops/server.env

# vercel
.vercel

# Yerel Docker Compose override (docker-compose.override.example.yml şablonu)
docker-compose.override.yml

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Yerel / sunucu DB yedekleri (scripts/backup.sh çıktısı)
/backups/

# Flutter mobile
/mobile/.dart_tool/
/mobile/.flutter-plugins
/mobile/.flutter-plugins-dependencies
/mobile/.packages
/mobile/build/
/mobile/ios/Pods/
/mobile/ios/.symlinks/
/mobile/ios/Flutter/Flutter.framework
/mobile/ios/Flutter/Flutter.podspec
/mobile/android/.gradle/
/mobile/android/local.properties
/mobile/android/key.properties
/mobile/**/GeneratedPluginRegistrant.*
/mobile/**/*.g.dart
/mobile/**/*.freezed.dart

# Yerel pazarlama video çıktıları
/marketing/assets/*.mp4
/mobile/*.mp4

# Terraform (infra/aws) — state kaynak ID'leri içerir, asla commit edilmez
# NOT: .terraform.lock.hcl BİLEREK commit edilir (pinned provider version, iac-quality)
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.backup
infra/**/*.tfvars

# Yerel calisma artiklari: ekran goruntuleri, analiz dokumleri, test raporlari
/*.png
/*.txt
/report.xml
/mobile/*.txt
/mobile/*.png

# next-pwa build ciktisi (next build uretir; standalone imaja girer)
/public/sw.js
/public/workbox-*.js
