# docker compose --env-file docker-compose.env.example up --build
# veya değişkenleri kopyalayıp .env.docker olarak kullanın.

AUTH_SECRET=
# OAuth kamu kökü — AUTH_URL / NEXTAUTH_URL otomatik buna yazılır (auth-public-url.ts).
# Örnek: AUTH_PUBLIC_HOST=uncloudy-xxxx.ngrok-free.dev
# Yerel: AUTH_PUBLIC_HOST=localhost:3000
# Google Console: https://<AUTH_PUBLIC_HOST>/api/auth/callback/google
# Not: Linux’ta HOSTNAME konteyner ID olabildiği için OAuth için AUTH_PUBLIC_HOST kullanın.
AUTH_PUBLIC_HOST=
AUTH_URL=http://localhost
NEXT_PUBLIC_APP_URL=http://localhost
# LAN VM örneği (docs/VM-LAN.md):
# AUTH_URL=http://emanetci.local
# NEXT_PUBLIC_APP_URL=http://emanetci.local
# AUTH_TRUST_HOST=true

# Postgres host portu compose’ta 5433 (localhost:5433). İç ağ: postgres:5432

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google ile girişte otomatik ADMIN rolü verilecek e-postalar (virgülle ayrılmış)
# Örnek: ADMIN_EMAILS=siz@gmail.com,diger@gmail.com
ADMIN_EMAILS=

# /api/admin/setup endpointi için gizli anahtar (boş → endpoint kapalı)
# Üret: openssl rand -hex 24
ADMIN_SETUP_KEY=

# Netgsm SMS (@netgsm/sms) — yalnızca esnaf (ayarlardaki GSM) ve NETGSM_ADMIN_PHONES; misafirlere SMS yok.
# NETGSM_USERNAME=
# NETGSM_PASSWORD=
# NETGSM_MSGHEADER=HEAD
# NETGSM_APPNAME=emanetci
# NETGSM_ADMIN_PHONES=5xxxxxxxxx,5yyyyyyyyy

# iyzico / e-posta vb. için hosttan .env içeriğini buraya taşıyın veya:
#   docker compose run --rm -e IYZICO_API_KEY=... web ...
# web servisi şu an sadece yukarıdakileri set eder; ek anahtarlar için:
#   docker compose --env-file .env.production up
