# docker compose --env-file docker-compose.env.example up --build
# veya değişkenleri kopyalayıp .env.docker olarak kullanın.

AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres host portu compose’ta 5433 (localhost:5433). İç ağ: postgres:5432

# iyzico / e-posta vb. için hosttan .env içeriğini buraya taşıyın veya:
#   docker compose run --rm -e IYZICO_API_KEY=... web ...
# web servisi şu an sadece yukarıdakileri set eder; ek anahtarlar için:
#   docker compose --env-file .env.production up
