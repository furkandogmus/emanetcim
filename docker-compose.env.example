# docker compose --env-file docker-compose.env.example up --build
# vm-update.sh: önce .env sonra bu dosya yüklenir (aynı anahtarlar için sonraki kazanır).

# Üret: openssl rand -base64 32
AUTH_SECRET=
# OAuth kamu kökü — tek kaynak. AUTH_URL / NEXTAUTH_URL buna göre ayarlanır (auth-public-url.ts).
# Nginx üzerinden: AUTH_PUBLIC_HOST=localhost  ve  PUBLIC_URL_PROTOCOL=http
# Doğrudan 3000: AUTH_PUBLIC_HOST=localhost:3000
# Ngrok: AUTH_PUBLIC_HOST=xxxx.ngrok-free.dev
# Google Console redirect: https://<alan>/api/auth/callback/google veya http://localhost/... (yerel)
AUTH_PUBLIC_HOST=localhost
NEXT_PUBLIC_APP_URL=http://localhost
# LAN VM örneği (docs/VM-LAN.md):
# NEXT_PUBLIC_APP_URL=http://emanetci.local
# AUTH_TRUST_HOST=true

# Postgres host portu compose’ta 5433 (localhost:5433). İç ağ: postgres:5432

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google ile girişte otomatik ADMIN rolü verilecek e-postalar (virgülle ayrılmış)
# Örnek: ADMIN_EMAILS=siz@gmail.com,diger@gmail.com
ADMIN_EMAILS=

# /api/admin/setup endpointi için gizli anahtar (boş → endpoint kapalı)
# Üret: openssl rand -hex 24
ADMIN_SETUP_KEY=

# Netgsm SMS (@netgsm/sms) — yalnızca esnaf (ayarlardaki GSM) ve NETGSM_ADMIN_PHONES; misafirlere SMS yok.
# NETGSM_USERNAME=
# NETGSM_PASSWORD=
# NETGSM_MSGHEADER=HEAD
# NETGSM_APPNAME=emanetci
# NETGSM_ADMIN_PHONES=5xxxxxxxxx,5yyyyyyyyy

# iyzico / e-posta vb. için hosttan .env içeriğini buraya taşıyın veya:
#   docker compose run --rm -e IYZICO_API_KEY=... web ...
# web servisi şu an sadece yukarıdakileri set eder; ek anahtarlar için:
#   docker compose --env-file .env.production up

# Ödeme: `false` (string) iken iyzico init/iade/webhook kapalı; üretimde IYZICO zorunluluğu da kalkar.
# PAYMENTS_ENABLED=false

# Postgres (pg Pool) — üretimde genelde artırın
# PG_POOL_MAX=16
# PG_POOL_IDLE_MS=30000
# PG_POOL_CONNECT_TIMEOUT_MS=10000
# Managed Postgres (SSL): DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Cron / iç endpoint: Bearer veya x-cron-secret
# CRON_SECRET=

# Gözlemlenebilirlik
# LOG_LEVEL=info
# APP_VERSION=1.0.0
# OBSERVABILITY_SERVICE_NAME=bagajpark
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.05
