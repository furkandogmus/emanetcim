# docker compose --env-file docker-compose.env.example up --build
# vm-update.sh: önce .env sonra bu dosya yüklenir (aynı anahtarlar için sonraki kazanır).

# Üret: openssl rand -base64 32
AUTH_SECRET=
# OAuth kamu kökü — tek kaynak. AUTH_URL / NEXTAUTH_URL buna göre ayarlanır (auth-public-url.ts).
# Nginx üzerinden: AUTH_PUBLIC_HOST=localhost  ve  PUBLIC_URL_PROTOCOL=http
# Doğrudan 3000: AUTH_PUBLIC_HOST=localhost:3000
# Ngrok: AUTH_PUBLIC_HOST=xxxx.ngrok-free.dev
# Google Console redirect: https://<alan>/api/auth/callback/google veya http://localhost/... (yerel)
AUTH_PUBLIC_HOST=localhost
NEXT_PUBLIC_APP_URL=http://localhost
# LAN VM örneği (docs/VM-LAN.md):
# NEXT_PUBLIC_APP_URL=http://emanetci.local
# AUTH_TRUST_HOST=true

# Postgres host portu compose’ta 5433 (localhost:5433). İç ağ: postgres:5432
# Üretimde mutlaka güçlü şifre:
# POSTGRES_USER=bagajpark
# POSTGRES_PASSWORD=
# POSTGRES_DB=bagajpark

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google ile girişte otomatik ADMIN rolü verilecek e-postalar (virgülle ayrılmış)
# Örnek: ADMIN_EMAILS=siz@gmail.com,diger@gmail.com
ADMIN_EMAILS=

# /api/admin/setup endpointi için gizli anahtar (boş → endpoint kapalı)
# Üret: openssl rand -hex 24
ADMIN_SETUP_KEY=

# Netgsm SMS (@netgsm/sms) — yalnızca esnaf (ayarlardaki GSM) ve NETGSM_ADMIN_PHONES; misafirlere SMS yok.
# NETGSM_USERNAME=
# NETGSM_PASSWORD=
# NETGSM_MSGHEADER=HEAD
# NETGSM_APPNAME=emanetci
# NETGSM_ADMIN_PHONES=5xxxxxxxxx,5yyyyyyyyy

# E-posta vb. için hosttan .env içeriğini buraya taşıyın veya:
# web servisi şu an sadece yukarıdakileri set eder; ek anahtarlar için:
#   docker compose --env-file .env.production up

# Postgres (pg Pool) — üretimde genelde artırın
# PG_POOL_MAX=16
# PG_POOL_IDLE_MS=30000
# PG_POOL_CONNECT_TIMEOUT_MS=10000
# Managed Postgres (SSL): DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Cron / iç endpoint: Bearer veya x-cron-secret
# CRON_SECRET=

# --- Ödeme ---
# Aktif ödeme sağlayıcısı. Varsayılan: manual (dükkanda tahsilat, PSP komisyonu yok).
# Iyzico/PayTR adaptörü yazıldığında burada değiştirilir; kamuya açık metinler
# kendiliğinden kartlı sürüme döner. Bilinmeyen değer -> uygulama açılışta hata verir.
# Ayrıntı: docs/PAYMENTS.md
# PAYMENT_PROVIDER=manual

# Gözlemlenebilirlik
# LOG_LEVEL=info
# APP_VERSION=1.0.0
# OBSERVABILITY_SERVICE_NAME=bagajpark
# Beta dönemi: header'da BETA rozeti göster (ödemesiz beta boyunca true)
# NEXT_PUBLIC_BETA_BADGE=true

# SEO / analitik (üretimde doldurun)
# NEXT_PUBLIC_BASE_URL=https://bagajpark.com   # sitemap/canonical/hreflang temeli; boşsa NEXT_PUBLIC_APP_URL kullanılır
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=        # Google Search Console doğrulama kodu
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=bagajpark.com   # çerez onayı sonrası Plausible yüklenir

# Upstash Redis: çoklu instance rate limit (src/lib/rate-limit.ts)
# Rate limit Redis (compose icinde varsayilan redis://redis:6379; yonetilen servis icin rediss://...)
# REDIS_URL=
# REQUIRE_DISTRIBUTED_RATE_LIMIT=true

# Postgres kimligi. POSTGRES_PASSWORD ZORUNLU: docker-compose.yml artik
# varsayilan bir parolaya dusmuyor (eskiden "bagajpark"a dusuyordu ve o deger
# uretimde fiilen kullaniliyordu). Uretimde SSM Parameter Store'dan gelir,
# bkz. ops/SECRETS.md.
POSTGRES_USER=bagajpark
POSTGRES_PASSWORD=
POSTGRES_DB=bagajpark

# ── Nesne depolama (S3) ────────────────────────────────────────────────────
# BESI BIRDEN tanimli olmadan yukleme yuzeyi HIC ACILMAZ: esnaf panelinde
# fotograf dugmesi cizilmez ve `getStorage()` sessizce bir seye dusmek yerine
# ATAR. Sebep: "fotograf yuklendi" deyip hicbir yere yazmamak, tam olarak bu
# kod tabanini bu hale getiren hata sinifi.
S3_BUCKET=
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Nesnelerin OKUNACAGI kok adres -- CloudFront alan adi ya da kovanin kendi
# adresi. Ayri tutuluyor cunku CDN onu eklemek yalnizca bu degeri degistirir.
# DIKKAT: bu alan adi `next.config.ts` icinde `next/image` remotePatterns'a
# BURADAN turetiliyor; degeri degistirince YENIDEN DERLEME gerekir.
S3_PUBLIC_BASE_URL=
# MinIO / R2 gibi S3 uyumlu servisler icin; AWS kullaniyorsan bos birak.
S3_ENDPOINT=
