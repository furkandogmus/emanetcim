{
  "name": "bagajpark",
  "version": "0.1.0",
  "description": "BagajPark (Emanetçi) — Turkey-focused luggage storage marketplace (Next.js, partners & seals).",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "i18n:extract": "npx i18next-parser",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run -t unit",
    "test:integration": "vitest run -t integration",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "link-check": "node scripts/check-internal-links.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d postgres",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate deploy",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web",
    "release:patch": "npm version patch -m \"chore(release): %s\"",
    "release:minor": "npm version minor -m \"chore(release): %s\"",
    "release:major": "npm version major -m \"chore(release): %s\""
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@upstash/redis": "^1.37.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.0",
    "framer-motion": "^12.40.0",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "maplibre-gl": "^5.22.0",
    "next": "16.2.2",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.9.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "resend": "^6.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "i18next-parser": "^9.0.2",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.8",
    "prisma": "^7.7.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "@swc/helpers": "0.5.21"
  },
  "browserslist": [
    "chrome >= 109",
    "edge >= 109",
    "firefox >= 115",
    "safari >= 16",
    "ios_saf >= 16",
    "not dead"
  ]
}
