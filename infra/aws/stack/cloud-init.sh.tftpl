#!/bin/bash
# İlk boot kurulumu — Amazon Linux 2023. Hetzner denetiminde bulunan hatayı (fail2ban'in
# yanlış portu koruması) burada day-1'den doğru kurarak tekrarlamamak icin ssh_port +
# SELinux port label + fail2ban birlikte ayarlanir.
set -e

dnf update -y

# --- firewalld: devre disi birak. AWS Security Group zaten ag seviyesinde 2222/80/443
# disinda hicbir portu acmiyor; firewalld'in varsayilan "public" zone'u ise SADECE
# standart "ssh" servisini (port 22) izin veriyor, 2222/80/443 hicbiri izinli degildi —
# Docker'in interface/zone etkilesimiyle bir noktada bu aktif hale gelip sshd'ye disaridan
# erisim "connection refused" ile tamamen kesildi (2026-08-21'de canli tespit edildi).
# Iki katmanli firewall (SG + firewalld) bu kurulumda fayda saglamiyor, kaldiriliyor.
systemctl disable --now firewalld 2>/dev/null || true

# --- Docker + Compose plugin ---
dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user

# Pinned surum yerine Docker'in kendi "latest" sembolik URL'i kullanilir (resmi kurulum
# dokumantasyonundaki yontem) — boot script'inde 404 riskini pinlemekten daha az onemli
# gorup, kurulumun ilk seferde basarili olmasini onceliklendirdik.
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# --- SSH portunu degistir (SELinux label once, sshd restart sonra) ---
dnf install -y policycoreutils-python-utils fail2ban git
semanage port -a -t ssh_port_t -p tcp ${ssh_port} || true
sed -i "s/^#\?Port .*/Port ${ssh_port}/" /etc/ssh/sshd_config
systemctl restart sshd

# --- fail2ban: dogru portu izlesin ---
cat > /etc/fail2ban/jail.local <<EOF
[sshd]
enabled = true
port = ${ssh_port}
maxretry = 5
bantime = 3600
findtime = 600
EOF
systemctl enable --now fail2ban

mkdir -p /opt/emanetci
chown ec2-user:ec2-user /opt/emanetci

# --- SSM Agent: AL2023'te varsayilan kurulu/etkin geliyor, guvenlik agi olarak yine de
# acikca enable ediliyor (CI/CD SSM Run Command ile deploy edecek, bkz. [[aws-paralel-ortam]]) ---
systemctl enable --now amazon-ssm-agent 2>/dev/null || true

# --- TLS materyalini SSM'den cek (statik AWS key kullanilmiyor, instance'in kendi
# IAM roluyle) — manuel scp bir daha gerekmiyor, bkz. [[aws-paralel-ortam]] design.md ---
if ! command -v aws >/dev/null 2>&1; then
  dnf install -y unzip
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install
  rm -rf /tmp/awscliv2.zip /tmp/aws
fi

# TLS materyali. DOSYA ADLARI nginx/conf.d/default.conf ile AYNI OLMAK ZORUNDA
# (ssl_certificate /etc/ssl/cloudflare/bagajpark.crt).
#
# 2026-08-29'a kadar buraya `aws-test.crt` / `aws-test.key` yaziliyordu, nginx ise
# `bagajpark.crt` istiyordu. Bugunku sunucu yalnizca dosyalar oraya ELLE
# konuldugu icin calisiyordu; stack yeniden kurulsa (EIP degisimi, bolge
# degisimi, felaket kurtarma) nginx sertifikayi bulamaz ve SITE ACILMAZDI.
# Yani felaket kurtarma yolu kirikti. (DEFECT_BACKLOG madde 5.)
#
# Ad degisikligi tek basina yeterli degildi: SSM'deki sertifika
# `aws-test.bagajpark.com` icindi, canli alan adi icin degil. Once canli
# sertifika/anahtar SSM'e tasindi (scripts/tls-put.sh), sonra bu adlar duzeltildi.
mkdir -p /etc/ssl/cloudflare
aws ssm get-parameter --name "${ssm_cert_name}" --with-decryption --region ${region} \
  --query Parameter.Value --output text > /etc/ssl/cloudflare/bagajpark.crt
aws ssm get-parameter --name "${ssm_key_name}" --with-decryption --region ${region} \
  --query Parameter.Value --output text > /etc/ssl/cloudflare/bagajpark.key
chmod 644 /etc/ssl/cloudflare/bagajpark.crt
chmod 600 /etc/ssl/cloudflare/bagajpark.key

# Cektigimiz sertifika gercekten bu alan adina mi ait? Yanlis sertifikayla acilan
# bir nginx, "calisiyor ama TLS hatasi veriyor" gibi teshisi zor bir duruma yol
# acar. Uyusmazlik varsa cloud-init'i BURADA durdurmak daha iyi.
if ! openssl x509 -in /etc/ssl/cloudflare/bagajpark.crt -noout -checkhost bagajpark.com >/dev/null 2>&1; then
  echo "HATA: SSM'deki sertifika bagajpark.com'u kapsamiyor" >&2
  openssl x509 -in /etc/ssl/cloudflare/bagajpark.crt -noout -ext subjectAltName >&2 || true
  exit 1
fi

echo "cloud-init tamam: $(date)" > /var/log/bagajpark-cloud-init-done
