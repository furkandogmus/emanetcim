{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://10.0.2.2:3000/api/mobile",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1034885764385-c5f4o8bo3ttdg193en2m5fabj8rja90l.apps.googleusercontent.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://bagajpark.com/api/mobile",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1034885764385-c5f4o8bo3ttdg193en2m5fabj8rja90l.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://bagajpark.com/api/mobile",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1034885764385-c5f4o8bo3ttdg193en2m5fabj8rja90l.apps.googleusercontent.com"
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://bagajpark.com/api/mobile"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "serviceAccountKeyPath": "./play-service-account.json"
      }
    }
  }
}
