{
  "expo": {
    "name": "BagajPark",
    "slug": "bagajpark",
    "scheme": "bagajpark",
    "version": "0.3.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bagajpark",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:bagajpark.com"
      ],
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "0A2A.1",
              "3B52.1",
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.bagajpark",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bagajpark.com",
              "pathPattern": "/.*/shop/.*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "BagajPark Face ID kullanmaz; oturum bilgisi cihazın güvenli deposunda saklanır."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 160,
          "backgroundColor": "#FDFCFB"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "tr",
            "en",
            "de",
            "ru"
          ]
        }
      ],
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki emanet noktalarını göstermek için konumunu kullanıyoruz.",
          "locationAlwaysAndWhenInUsePermission": "Konumunu yalnızca uygulama açıkken, yakınındaki emanet noktalarını göstermek için kullanıyoruz.",
          "locationAlwaysPermission": "Konumunu yalnızca uygulama açıkken, yakınındaki emanet noktalarını göstermek için kullanıyoruz.",
          "motionUsagePermission": "BagajPark hareket verisi kullanmaz."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Misafirin rezervasyon QR kodunu okutmak için kamerayı kullanıyoruz.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Misafirin rezervasyon QR kodunu okutmak için kamerayı kullanıyoruz.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#EA580C",
          "defaultChannel": "default"
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class org.maplibre.** { *; }\n-dontwarn org.maplibre.**"
          }
        }
      ],
      "./plugins/with-optional-portrait"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e977b077-e469-4d63-a705-99b7ddd86346"
      },
      "appleSignIn": true
    },
    "owner": "furkandogmus",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e977b077-e469-4d63-a705-99b7ddd86346",
      "fallbackToCacheTimeout": 0
    },
    "locales": {
      "tr": "./ios-locales/tr.json",
      "en": "./ios-locales/en.json",
      "de": "./ios-locales/de.json",
      "ru": "./ios-locales/ru.json"
    }
  }
}
