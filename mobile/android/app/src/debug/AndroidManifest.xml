<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Yerel gelistirme sirasinda backend http:// uzerinden calisir
         (ornek: http://192.168.1.240:3000/api/mobile). Android 9+ duz metin
         trafigi varsayilan olarak engeller. Bu yalnizca DEBUG varyantinda
         gecerlidir; release/main manifest'e dokunulmaz, uretim HTTPS-only kalir. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
