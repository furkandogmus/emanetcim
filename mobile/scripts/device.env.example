# mobile/.device.env — scripts/device.sh bu dosyayi okur. Kopyala: cp scripts/device.env.example .device.env
# Gitignored (.env* kuralı). Gercek IP/port buraya, repoya degil.

# Kablosuz adb hedefi (adb devices ciktisindaki ad). USB'de bos birakilabilir.
ADB_DEVICE=192.168.1.50:5555

# Yerel backend (npm run dev calisan makinenin LAN IP'si). ASLA bagajpark.com yazma.
API_BASE_URL=http://192.168.1.10:3000/api/mobile
