# Kopyala: cp ops/server.env.example ops/server.env, degerleri doldur.
# ops/server.env git'e girmez (.gitignore'da acikca listeli) - gercek sunucu bilgisi
# sadece burada, yerelde durur.

# Hetzner VPS erisim bilgileri
SSH_HOST=
SSH_PORT=
SSH_USER=
# ssh-keygen -t ed25519 -f ~/.ssh/bagajpark_ops_ed25519 ile uretilen key
SSH_KEY_PATH=~/.ssh/bagajpark_ops_ed25519

# Sunucuda repo'nun bulundugu dizin (vm-update.sh buradan calisir)
APP_DIR=

# Prod domain (nginx / TLS / Cloudflare kontrolleri icin)
DOMAIN=bagajpark.com
