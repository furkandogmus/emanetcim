generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                   @id @default(uuid())
  role                     Role                     @default(GUEST)
  email                    String?                  @unique
  emailVerified            DateTime?
  image                    String?
  phone                    String?                  @unique
  name                     String?
  /// bcrypt hash; OAuth-only kullanıcılarda null
  passwordHash             String?
  isBanned               Boolean           @default(false)
  /// JWT token sürümü — şifre değişikliğinde artırılır, eski token'lar geçersiz olur
  tokenVersion           Int               @default(0)
  lastIp                   String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  /// Referans kodu: misafire verilebilir, yeni rezervasyonda indirim sağlar
  referralCode             String?                  @unique
  /// Sadakat puanı — her 1 TL harcamada 1 puan, 100 puan = 1 TL indirim
  loyaltyPoints            Int                      @default(0)
  accounts                 Account[]
  adminRoleChangeRequested AdminRoleChangeRequest[] @relation("AdminRoleChangeRequester")
  adminRoleChangeTargets   AdminRoleChangeRequest?  @relation("AdminRoleChangeTarget")
  bookings                 Booking[]
  legalAcceptances         LegalAcceptance[]
  pushSubscriptions        PushSubscription[]
  mobilePushTokens         MobilePushToken[]
  reviews                  Review[]
  sessions                 Session[]
  shops                    Shop[]

  @@index([email])
}

/// Admin ↔ admin rol değişikliği: çoklu admin varken ikinci onay; tek adminde anında uygulanır.
model AdminRoleChangeRequest {
  id                String   @id @default(cuid())
  targetUserId      String   @unique
  previousRole      Role
  requestedRole     Role
  requestedByUserId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  requestedBy       User     @relation("AdminRoleChangeRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  targetUser        User     @relation("AdminRoleChangeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([requestedByUserId])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model Shop {
  id               String        @id @default(uuid())
  ownerId          String
  name              String
  address           String?
  image             String?
  description       String?
  latitude          Float?
  longitude         Float?
  capacity          Int           @default(10)
  isActive          Boolean       @default(false)
  rating            Float?        @default(0.0)
  pricePerDay       Decimal       @default(50) @db.Decimal(12, 2)
  pricePerHour       Decimal       @default(10) @db.Decimal(12, 2)
  timezone          String        @default("Europe/Istanbul")
  hasRestroom       Boolean       @default(false)
  hasCctv           Boolean       @default(false)
  hasClimateControl Boolean       @default(false)
  acceptsLargeItems Boolean       @default(false)
  open247          Boolean       @default(false)
  openingTime      String?       @default("09:00")
  closingTime      String?       @default("20:00")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  city             String?
  district         String?
  sealLeadTimeDays Int           @default(3)
  sealReorderPoint Int           @default(15)
  /// Doğrulanmış dükkan rozeti (güven & güvenilirlik)
  isVerified       Boolean       @default(false)
  /// Ortalama yanıt süresi (dakika cinsinden)
  responseTimeMinutes Int?       @default(0)
  bookings         Booking[]
  reviews          Review[]
  seals            Seal[]
  sealRequests     SealRequest[]
  images           ShopImage[]
  timeSlots        ShopTimeSlot[]
  owner            User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([isActive])
  @@index([latitude, longitude])
}

model ShopImage {
  id        String   @id @default(uuid())
  shopId    String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

/// 30-minute bookable time slot per shop
model ShopTimeSlot {
  id        String   @id @default(cuid())
  shopId    String
  startTime DateTime // 2026-06-15T09:00:00Z
  endTime   DateTime // 2026-06-15T09:30:00Z
  capacity  Int      @default(10)
  isActive  Boolean  @default(true)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  reservations ReservationSlot[]

  @@unique([shopId, startTime])
  @@index([shopId, startTime, endTime])
  @@index([startTime])
}

/// Links a booking to specific time slots
model ReservationSlot {
  id        String       @id @default(cuid())
  bookingId String
  slotId    String
  bagCount  Int
  booking   Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  slot      ShopTimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([bookingId, slotId])
  @@index([slotId])
  @@index([bookingId])
}

model Booking {
  id                     String            @id @default(uuid())
  guestId                String?
  shopId                 String
  status                 BookingStatus     @default(PENDING)
  /// E-posta ile guest checkout (accountsız kullanıcılar için)
  guestEmail             String?
  /// Telefon ile guest checkout
  guestPhone             String?
  checkInTime            DateTime
  checkOutTime           DateTime
  bagCountS              Int               @default(0)
  bagCountM              Int               @default(0)
  bagCountXl             Int               @default(0)
  unitPrice              Decimal           @default(50) @db.Decimal(12, 2)
  totalPrice             Decimal           @default(0) @db.Decimal(12, 2)
  /// Sigorta / güvence ücreti (iptal ve erken iade hesaplarında hariç tutulur)
  insuranceFee           Decimal           @default(0) @db.Decimal(12, 2)
  qrCodeToken            String?           @unique
  sealPhotoUrl           String?
  lateFeeApplied         Decimal           @default(0) @db.Decimal(12, 2)
  pendingBagRevision     Json?
  /// Erken teslimat iadesi başarısız olduysa reconcile için tutulan tutar
  failedRefundAmount     Decimal?          @default(0) @db.Decimal(12, 2)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  /// Eşzamanlı durum geçişleri için optimistic sürüm (onay vb. updateMany ile artırılır).
  bookingRowVersion      Int               @default(0)
  /// Referans kodu ile uygulanan indirim miktarı (TRY)
  referralDiscountAmount Decimal           @default(0) @db.Decimal(12, 2)
  /// Rezervasyonda kullanılan referans kodu (varsa)
  referredByCode         String?
  reservationSlots       ReservationSlot[]
  guest                  User?             @relation(fields: [guestId], references: [id], onDelete: Cascade)
  shop                   Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  seals                  BookingSeal[]
  dispute                Dispute?
  notificationLogs       NotificationLog[]
  paymentLog             PaymentLog?
  review                 Review?

  @@index([guestId])
  @@index([shopId])
  @@index([status])
  @@index([checkInTime])
  @@index([checkOutTime])
  @@index([createdAt])
  @@index([shopId, status])
  @@index([status, checkInTime])
  @@index([status, checkOutTime])
  @@index([guestId, status])
}

/// Rezervasyon başına tek ödeme defteri satırı.
///
/// Bu tablonun TEK yazıcısı `src/services/PaymentService.ts`'tir. Ham
/// `prisma.paymentLog.update` çağrısı yapmayın: durum geçişleri orada
/// doğrulanıyor ve her geçiş `BookingEvent`'e denetim izi bırakıyor.
model PaymentLog {
  id               String        @id @default(uuid())
  bookingId        String        @unique
  transactionId    String?       @unique
  /// Brüt tutar (rezervasyonun toplam bedeli).
  amount           Decimal       @db.Decimal(12, 2)
  /// Bugüne kadar iade edilen toplam. `amount`'a eşitse durum REFUNDED olur.
  refundedAmount   Decimal       @default(0) @db.Decimal(12, 2)
  currency         String        @default("TRY")
  /// Kaydı üreten sağlayıcı adı — `PaymentProvider.capabilities.id` ile aynı.
  /// Lansmanda "manual" (dükkanda tahsilat); PSP entegrasyonu sonrası "iyzico" vb.
  provider         String        @default("manual")
  /// Sağlayıcının kendi işlem referansı.
  providerRef      String?
  /// Aynı niyetin iki kez açılmasını engeller.
  idempotencyKey   String?       @unique
  status           PaymentStatus @default(PENDING)
  /// FAILED durumunda sağlayıcının verdiği sebep.
  failureReason    String?
  splitCompleted   Boolean       @default(false)
  capturedAt       DateTime?
  refundedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  chargebackNote   String?
  /// Chargeback incelemesi: OPEN | WON | LOST | null
  chargebackStatus String?
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([splitCompleted])
  @@index([createdAt])
  @@index([provider, status])
}

model NotificationLog {
  id        String   @id @default(uuid())
  bookingId String?
  type      String
  recipient String
  subject   String?
  content   String
  status    String   @default("SENT")
  error     String?
  createdAt DateTime @default(now())
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([recipient])
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  guestId   String
  shopId    String
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guest     User     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([guestId])
}

model Coupon {
  id        String    @id @default(uuid())
  code      String    @unique
  discount  Decimal   @db.Decimal(12, 2)
  isPercent Boolean   @default(true)
  minPrice  Decimal?  @default(0) @db.Decimal(12, 2)
  maxUses   Int?      @default(100)
  usedCount Int       @default(0)
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([isActive])
  @@index([expiresAt])
}

model Dispute {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  reason      String
  description String
  status      String   @default("OPEN")
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

/// Fiziksel mühür stoku (seri numarası = PK)
model Seal {
  serialNumber Int           @id
  shopId       String?
  status       SealStatus    @default(STOCK)
  assignedAt   DateTime?
  bookingSeals BookingSeal[]
  shop         Shop?         @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([status])
  @@index([shopId, status])
}

/// Rezervasyonda hangi mühür hangi valize takıldı
model BookingSeal {
  id         String   @id @default(uuid())
  bookingId  String
  sealNumber Int
  bagIndex   Int
  bagSize    String
  photoUrl   String?
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seal       Seal     @relation(fields: [sealNumber], references: [serialNumber])

  @@unique([bookingId, bagIndex])
  @@index([sealNumber])
}

model SealRequest {
  id             String   @id @default(uuid())
  shopId         String
  quantity       Int
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  adminNote      String?
  autoGenerated  Boolean  @default(false)
  requestedBy    String?
  serialFrom     Int?
  serialTo       Int?
  trackingNumber String?
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
}

model Campaign {
  id              String    @id @default(uuid())
  name            String
  message         String?
  discountPercent Decimal?  @db.Decimal(5, 2)
  isActive        Boolean   @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
}

/// Tek satır platform iş kuralları (panelden güncellenebilir).
/// Runtime feature toggles (admin UI + optional env kill switch for payments).
model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  enabled        Boolean  @default(true)
  /// 0–100; applied when userId is present. Backend paths without userId skip rollout (webhooks stay consistent).
  rolloutPct     Int      @default(100)
  /// Non-empty JSON string[] = allowlist for identified users only; empty/null = no allowlist restriction.
  allowedUserIds Json?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([key])
}

model PlatformSettings {
  id                   String   @id @default("default")
  maxStayDays          Int      @default(30)
  maxBagsPerSlot       Int      @default(50)
  insuranceFeeTry      Decimal  @default(15) @db.Decimal(12, 2)
  earlyRefundRatio     Decimal  @default(0.9) @db.Decimal(6, 4)
  cancelFixedFeeTry    Decimal  @default(20) @db.Decimal(12, 2)
  defaultShopCapacity  Int      @default(10)
  defaultPricePerDay   Decimal  @default(50) @db.Decimal(12, 2)
  bagMultiplierS       Decimal  @default(1.0) @db.Decimal(6, 4)
  bagMultiplierM       Decimal  @default(1.0) @db.Decimal(6, 4)
  bagMultiplierXl      Decimal  @default(1.0) @db.Decimal(6, 4)
  updatedAt            DateTime @updatedAt
  /// Platform genelinde rezervasyona kapalı takvim günleri (YYYY-MM-DD JSON dizisi).
  platformHolidayDates Json?
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorRole   String
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model LegalAcceptance {
  id          String   @id @default(cuid())
  userId      String
  documentKey String
  version     String
  acceptedAt  DateTime @default(now())
  ip          String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentKey])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MobilePushToken {
  token      String   @id
  userId     String
  platform   String   // ios, android
  appVersion String?
  locale     String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BlockedIp {
  ip        String   @id
  reason    String?
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  from      String
  to        String
  subject   String?
  text      String?
  html      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  raw       Json?
}

model BlogPost {
  id          String   @id @default(uuid())
  locale      String
  slug        String   @unique
  title       String
  content     String
  excerpt     String?
  coverImage  String?
  authorName  String   @default("BagajPark Ekibi")
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locale])
  @@index([isPublished])
}

/// Append-only booking event log — booking'in tüm durum değişikliklerini kaydeder
/// Dispute çözümlerinde booking yaşam döngüsünü kanıtlamak için kullanılır
model BookingEvent {
  id          String   @id @default(cuid())
  bookingId   String
  event       String   // CREATED, PAID, CHECKED_IN, CHECKED_OUT, CANCELLED, APPROVED, WAITING_APPROVAL, MODIFIED, DISPUTED, REFUNDED
  actorId     String?  // kim yaptı (userId)
  actorRole   Role?    // GUEST, PARTNER, ADMIN
  metadata    Json?    // event-specific data (eski durum, yeni durum, tutar, vs.)
  createdAt   DateTime @default(now())

  @@index([bookingId])
  @@index([bookingId, createdAt])
}

enum Role {
  GUEST
  PARTNER
  ADMIN
}

enum BookingStatus {
  PENDING
  PAID
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  WAITING_APPROVAL
  APPROVED
}

/// Ödeme defteri durumları.
///
/// `PENDING` VARSAYILANDIR ve öyle kalmalı. Önceki varsayılan `SUCCESS` idi; bu,
/// hiçbir kart çekilmeden "başarılı" ödeme kaydı üretilmesine ve prod'da
/// karşılığı olmayan 3.480 TRY'lik deftere yol açtı (2026-08-22 denetimi, P0-0).
enum PaymentStatus {
  /// Niyet açıldı, para henüz alınmadı.
  PENDING
  /// Kart provizyonu alındı ama tahsil edilmedi (3DS/auth-capture akışı).
  AUTHORIZED
  /// Para tahsil edildi.
  SUCCESS
  /// Sağlayıcı reddetti veya tahsilat yapılamadı.
  FAILED
  /// Tamamı iade edildi.
  REFUNDED
  /// Bir kısmı iade edildi; `refundedAmount` ne kadarını söyler.
  PARTIALLY_REFUNDED
  /// Tahsilat yapılmadan niyet kapatıldı (rezervasyon iptali vb.).
  CANCELLED
}

enum SealStatus {
  STOCK
  ASSIGNED
  IN_USE
  RETURNED
  FAULTY
}
