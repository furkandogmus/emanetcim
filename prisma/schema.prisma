generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                   @id @default(uuid())
  role                     Role                     @default(GUEST)
  email                    String?                  @unique
  emailVerified            DateTime?
  image                    String?
  phone                    String?                  @unique
  name                     String?
  /// bcrypt hash; OAuth-only kullanıcılarda null
  passwordHash             String?
  isBanned                 Boolean                  @default(false)
  /// JWT token sürümü — şifre değişikliğinde artırılır, eski token'lar geçersiz olur
  tokenVersion             Int                      @default(0)
  lastIp                   String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  /// Referans kodu: misafire ya da esnafa verilebilir. Misafirde yeni
  /// rezervasyonda indirim sağlar (`referralCode` alanı Booking'de); esnafta
  /// yeni bir esnaf başvurusunu davet edene bağlar (`referredByPartnerId`).
  referralCode             String?                  @unique
  /// Sadakat puanı — her 1 TL harcamada 1 puan, 100 puan = 1 TL indirim
  loyaltyPoints            Int                      @default(0)
  /// Bu esnabı davet eden esnafın User.id'si (varsa). İlişki bilerek yok —
  /// davet eden hesap silinse de bu kayıt kalmalı. Ödül mekanizması henüz
  /// otomatik değil (bkz. docs/KOD_TARAMA_2026-08-23.md) — bilinçli iş kararı
  /// bekliyor; şimdilik yalnızca atıf kaydediliyor.
  referredByPartnerId      String?
  accounts                 Account[]
  adminRoleChangeRequested AdminRoleChangeRequest[] @relation("AdminRoleChangeRequester")
  adminRoleChangeTargets   AdminRoleChangeRequest?  @relation("AdminRoleChangeTarget")
  bookings                 Booking[]
  legalAcceptances         LegalAcceptance[]
  pushSubscriptions        PushSubscription[]
  mobilePushTokens         MobilePushToken[]
  reviews                  Review[]
  sessions                 Session[]
  shops                    Shop[]

  @@index([email])
}

/// Admin ↔ admin rol değişikliği: çoklu admin varken ikinci onay; tek adminde anında uygulanır.
model AdminRoleChangeRequest {
  id                String   @id @default(cuid())
  targetUserId      String   @unique
  previousRole      Role
  requestedRole     Role
  requestedByUserId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  requestedBy       User     @relation("AdminRoleChangeRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  targetUser        User     @relation("AdminRoleChangeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([requestedByUserId])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model Shop {
  id                  String              @id @default(uuid())
  ownerId             String
  name                String
  address             String?
  image               String?
  description         String?
  latitude            Float?
  longitude           Float?
  capacity            Int                 @default(10)
  isActive            Boolean             @default(false)
  rating              Float?              @default(0.0)
  pricePerDay         Decimal             @default(50) @db.Decimal(12, 2)
  pricePerHour        Decimal             @default(10) @db.Decimal(12, 2)
  timezone            String              @default("Europe/Istanbul")
  hasRestroom         Boolean             @default(false)
  hasCctv             Boolean             @default(false)
  hasClimateControl   Boolean             @default(false)
  acceptsLargeItems   Boolean             @default(false)
  open247             Boolean             @default(false)
  openingTime         String?             @default("09:00")
  closingTime         String?             @default("20:00")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  city                String?
  district            String?
  sealLeadTimeDays    Int                 @default(3)
  sealReorderPoint    Int                 @default(15)
  /// Doğrulanmış dükkan rozeti (güven & güvenilirlik)
  isVerified          Boolean             @default(false)
  /// Ortalama yanıt süresi (dakika cinsinden)
  responseTimeMinutes Int?                @default(0)
  /// Test/demo kaydı. Kamuya açık hiçbir listede, aramada veya istatistikte görünmez.
  ///
  /// NEDEN: 2026-08-22'de Türkiye'de bulunabilen üç dükkandan biri kişisel bir test
  /// kaydıydı (`Furkan'ın Diğer Mekan`) ve gerçek partnerden ayırt edilemiyordu.
  /// `isActive = false` yapmak da işe yaramıyordu: dükkanın 5 rezervasyonu var ve
  /// kapatmak esnaf akışlarını bozuyor. Doğru ayrım "aktif mi" değil, "gerçek mi".
  /// Filtre tek yerde: `src/lib/public-shop-filter.ts` (P1-4).
  isTest              Boolean             @default(false)
  /// Talep testi noktasi: aramada ve haritada GORUNUR, rezervasyona KAPALIDIR.
  ///
  /// NEDEN: bir sehirde esnafla anlasmadan once orada musteri olup olmadigini
  /// olcmek gerekiyor -- yoksa talebi olmayan bir sehre onboarding maliyeti
  /// yatiriliyor. Nokta normal bir kayit gibi listelenir, misafir tiklar ve
  /// rezervasyona kalkisir; o AN "burasi yakinda aciliyor, haber verelim" gorur
  /// ve isterse e-posta birakir (`PrelaunchInterest`). Olculen sey tam olarak
  /// budur: hangi sehirde kac kisi rezervasyona kalkisti.
  ///
  /// `isTest`ten FARKI: isTest kaydi kamuya HIC gorunmez (P1-4). Bu gorunur ama
  /// rezervasyon URETMEZ -- kimse olmayan bir adrese gonderilmez. Kural tek
  /// yerde: `src/lib/public-shop-filter.ts` -> `OPERATING_SHOP_FILTER`, ve
  /// sunucu tarafi kapisi `createInitialBooking` icinde.
  isPrelaunch         Boolean             @default(false)
  prelaunchInterests  PrelaunchInterest[]
  prelaunchWants      PrelaunchWant[]
  bookings            Booking[]
  reviews             Review[]
  seals               Seal[]
  sealRequests        SealRequest[]
  images              ShopImage[]
  timeSlots           ShopTimeSlot[]
  owner               User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  merchantProfile        MerchantProfile?
  merchantPaymentAccount MerchantPaymentAccount[]
  paymentSplits          PaymentSplit[]

  @@index([ownerId])
  @@index([isActive])
  @@index([latitude, longitude])
  /// Kamuya açık dükkan filtresi (`src/lib/public-shop-filter.ts`) her aramada
  /// bu iki alana birlikte bakıyor.
  @@index([isTest, isActive])
}

model ShopImage {
  id        String   @id @default(uuid())
  shopId    String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

/// 30-minute bookable time slot per shop
model ShopTimeSlot {
  id           String            @id @default(cuid())
  shopId       String
  startTime    DateTime // 2026-06-15T09:00:00Z
  endTime      DateTime // 2026-06-15T09:30:00Z
  capacity     Int               @default(10)
  isActive     Boolean           @default(true)
  shop         Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  reservations ReservationSlot[]

  @@unique([shopId, startTime])
  @@index([shopId, startTime, endTime])
  @@index([startTime])
}

/// Links a booking to specific time slots
model ReservationSlot {
  id        String       @id @default(cuid())
  bookingId String
  slotId    String
  bagCount  Int
  booking   Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  slot      ShopTimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([bookingId, slotId])
  @@index([slotId])
  @@index([bookingId])
}

model Booking {
  id                     String            @id @default(uuid())
  guestId                String?
  shopId                 String
  status                 BookingStatus     @default(PENDING)
  /// E-posta ile guest checkout (accountsız kullanıcılar için)
  guestEmail             String?
  /// Telefon ile guest checkout
  guestPhone             String?
  /// REZERVE edilen pencere. Yaratılışta yazılır, yaşam döngüsü boyunca DEĞİŞMEZ.
  ///
  /// 2026-08-22'ye kadar `checkOut()` buraya `now` yazıyordu, yani rezerve bitiş
  /// zamanı yok oluyordu. Gecikme ücreti ve erken iade ikisi de bu alandan
  /// hesaplandığı için, çıkıştan sonra faturanın girdileri yeniden kurulamıyordu
  /// (P1-10). Gerçekleşen zamanlar artık `checkedInAt` / `checkedOutAt`.
  checkInTime            DateTime
  checkOutTime           DateTime
  /// GERÇEKLEŞEN teslim alma anı. Bavul dükkana bırakıldığında yazılır.
  checkedInAt            DateTime?
  /// GERÇEKLEŞEN teslim etme anı. Bavul misafire verildiğinde yazılır.
  checkedOutAt           DateTime?
  bagCountS              Int               @default(0)
  bagCountM              Int               @default(0)
  bagCountXl             Int               @default(0)
  unitPrice              Decimal           @default(50) @db.Decimal(12, 2)
  totalPrice             Decimal           @default(0) @db.Decimal(12, 2)
  /// Sigorta / güvence ücreti (iptal ve erken iade hesaplarında hariç tutulur)
  insuranceFee           Decimal           @default(0) @db.Decimal(12, 2)
  qrCodeToken            String?           @unique
  sealPhotoUrl           String?
  lateFeeApplied         Decimal           @default(0) @db.Decimal(12, 2)
  pendingBagRevision     Json?
  /// Erken teslimat iadesi başarısız olduysa reconcile için tutulan tutar
  failedRefundAmount     Decimal?          @default(0) @db.Decimal(12, 2)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  /// Eşzamanlı durum geçişleri için optimistic sürüm (onay vb. updateMany ile artırılır).
  bookingRowVersion      Int               @default(0)
  /// Rezervasyonun fiyatını üreten kural kümesinin ANLIK KOPYASI (`PricingRules`).
  ///
  /// NEDEN: `PlatformSettings` tek satırlık ve sürümsüz — admin bir çarpanı
  /// değiştirdiği anda GEÇMİŞ tahsilatlar yeniden üretilemez hale geliyordu.
  /// 2026-08-22'de ölçüldü: 19 rezervasyonun tamamı `insuranceFee = 150.00`
  /// taşıyor, canlı ayar `0.00`; kayıtlı 440.00'lık bir toplam bugünkü kurallarla
  /// 150.00 çıkıyor. Anlaşmazlıkta, faturada ve iadede "o gün hangi kural
  /// geçerliydi" sorusunun cevabı burasıdır.
  ///
  /// Yalnızca rezervasyon YARATILIRKEN yazılır, sonra DEĞİŞMEZ.
  pricingSnapshot        Json?
  /// Referans kodu ile uygulanan indirim miktarı (TRY)
  referralDiscountAmount Decimal           @default(0) @db.Decimal(12, 2)
  /// Rezervasyonda kullanılan referans kodu (varsa)
  referredByCode         String?
  reservationSlots       ReservationSlot[]
  guest                  User?             @relation(fields: [guestId], references: [id], onDelete: Cascade)
  shop                   Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  seals                  BookingSeal[]
  dispute                Dispute?
  notificationLogs       NotificationLog[]
  paymentLog             PaymentLog?
  review                 Review?

  @@index([guestId])
  @@index([shopId])
  @@index([status])
  @@index([checkInTime])
  @@index([checkOutTime])
  @@index([createdAt])
  @@index([shopId, status])
  @@index([status, checkInTime])
  @@index([status, checkOutTime])
  @@index([guestId, status])
  /// Süre aşımı taraması: çıkış saati geçmiş ama hâlâ açık rezervasyonlar.
  @@index([status, checkedOutAt])
}

/// Rezervasyon başına tek ödeme defteri satırı.
///
/// Bu tablonun TEK yazıcısı `src/services/PaymentService.ts`'tir. Ham
/// `prisma.paymentLog.update` çağrısı yapmayın: durum geçişleri orada
/// doğrulanıyor ve her geçiş `BookingEvent`'e denetim izi bırakıyor.
model PaymentLog {
  id               String        @id @default(uuid())
  bookingId        String        @unique
  transactionId    String?       @unique
  /// Brüt tutar (rezervasyonun toplam bedeli).
  amount           Decimal       @db.Decimal(12, 2)
  /// Bugüne kadar iade edilen toplam. `amount`'a eşitse durum REFUNDED olur.
  refundedAmount   Decimal       @default(0) @db.Decimal(12, 2)
  currency         String        @default("TRY")
  /// Kaydı üreten sağlayıcı adı — `PaymentProvider.capabilities.id` ile aynı.
  /// Lansmanda "manual" (dükkanda tahsilat); PSP entegrasyonu sonrası "iyzico" vb.
  provider         String        @default("manual")
  /// Sağlayıcının kendi işlem referansı.
  providerRef      String?
  /// Aynı niyetin iki kez açılmasını engeller.
  idempotencyKey   String?       @unique
  status           PaymentStatus @default(PENDING)
  /// FAILED durumunda sağlayıcının verdiği sebep.
  failureReason    String?
  splitCompleted   Boolean       @default(false)
  capturedAt       DateTime?
  refundedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  chargebackNote   String?
  /// Chargeback incelemesi: OPEN | WON | LOST | null
  chargebackStatus String?
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  split            PaymentSplit?

  @@index([status])
  @@index([splitCompleted])
  @@index([createdAt])
  @@index([provider, status])
}

model NotificationLog {
  id        String   @id @default(uuid())
  bookingId String?
  type      String
  recipient String
  subject   String?
  content   String
  status    String   @default("SENT")
  error     String?
  createdAt DateTime @default(now())
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([recipient])
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  guestId   String
  shopId    String
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guest     User     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([guestId])
}

model Coupon {
  id        String    @id @default(uuid())
  code      String    @unique
  discount  Decimal   @db.Decimal(12, 2)
  isPercent Boolean   @default(true)
  minPrice  Decimal?  @default(0) @db.Decimal(12, 2)
  maxUses   Int?      @default(100)
  usedCount Int       @default(0)
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([isActive])
  @@index([expiresAt])
}

model Dispute {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  reason      String
  description String
  status      String   @default("OPEN")
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

/// Fiziksel mühür stoku (seri numarası = PK)
/// Fiziksel mühür envanteri.
///
/// DEĞİŞMEZ KURAL (DB kısıtı `Seal_ownership_matches_status` ile zorlanır):
/// `STOCK` dışındaki her mühür bir dükkana ait olmak ZORUNDA; `STOCK` olan hiçbir
/// mühür bir dükkana ait OLAMAZ.
///
/// Neden DB'de: 2026-08-22'de 1.277 mührün 1.247'si `ASSIGNED` ama `shopId` NULL'du
/// — anlaşmazlıkta zilyetlik kanıtı olan envanterin %96'sı bir dükkanla
/// eşleştirilemiyordu. Kaynak `SealRepository.updateStatus`'tu ama beş ayrı yer ham
/// `seal.update*` çağırıyor; kuralın yeri koddan biri değil, veritabanıdır.
///
/// Kısıt `NOT VALID` eklendi (mevcut bozuk satırlar tolere edilir, yeni yazımlar
/// edilmez). Onarım sonrası `VALIDATE CONSTRAINT` ile tamamlanır —
/// bkz. `scripts/README.md`.
model Seal {
  serialNumber Int           @id
  shopId       String?
  status       SealStatus    @default(STOCK)
  assignedAt   DateTime?
  bookingSeals BookingSeal[]
  shop         Shop?         @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([status])
  @@index([shopId, status])
}

/// Rezervasyonda hangi mühür hangi valize takıldı
model BookingSeal {
  id         String   @id @default(uuid())
  bookingId  String
  sealNumber Int
  bagIndex   Int
  bagSize    String
  photoUrl   String?
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seal       Seal     @relation(fields: [sealNumber], references: [serialNumber])

  @@unique([bookingId, bagIndex])
  @@index([sealNumber])
}

model SealRequest {
  id             String   @id @default(uuid())
  shopId         String
  quantity       Int
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  adminNote      String?
  autoGenerated  Boolean  @default(false)
  requestedBy    String?
  serialFrom     Int?
  serialTo       Int?
  trackingNumber String?
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
}

model Campaign {
  id              String    @id @default(uuid())
  name            String
  message         String?
  discountPercent Decimal?  @db.Decimal(5, 2)
  isActive        Boolean   @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
}

/// Tek satır platform iş kuralları (panelden güncellenebilir).
/// Runtime feature toggles (admin UI + optional env kill switch for payments).
model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  enabled        Boolean  @default(true)
  /// 0–100; applied when userId is present. Backend paths without userId skip rollout (webhooks stay consistent).
  rolloutPct     Int      @default(100)
  /// Non-empty JSON string[] = allowlist for identified users only; empty/null = no allowlist restriction.
  allowedUserIds Json?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([key])
}

/// Platform geneli iş kuralları. TEK SATIR: id = "default".
///
/// BURADAKİ `@default` DEĞERLERİ `DEFAULT_PRICING_RULES` (src/lib/pricing-rules.ts)
/// İLE AYNI OLMAK ZORUNDA. 2026-08-22'de üçü de farklıydı — şema 1.0/1.0/1.0, kod
/// 0.8/1.0/1.5, canlı satır 1.0/1.0/1.0 — ve kod varsayılanı yalnızca satır YOKKEN
/// devreye girdiği için prod'da hiç çalışmıyordu. Sonuç: birisi boy bazlı
/// fiyatlandırmayı "düzelttiğini" sanarken XL bavul hâlâ küçük bavul fiyatı ödüyordu.
/// `src/__tests__/pricing-defaults.test.ts` ikisinin ayrışmasını CI'da kırmızı yakar.
model PlatformSettings {
  id                     String   @id @default("default")
  maxStayDays            Int      @default(30)
  maxBagsPerSlot         Int      @default(50)
  insuranceFeeTry        Decimal  @default(0) @db.Decimal(12, 2)
  earlyRefundRatio       Decimal  @default(1.0) @db.Decimal(6, 4)
  cancelFixedFeeTry      Decimal  @default(0) @db.Decimal(12, 2)
  /// Geç teslim alma ücreti. KENDİ ALANI: eskiden `cancelFixedFeeTry` ödünç
  /// alınıyordu (BookingService), yani iptal ücretini değiştiren gecikme ücretini de
  /// farkında olmadan değiştiriyordu.
  latePickupFeeTry       Decimal  @default(0) @db.Decimal(12, 2)
  /// Gecikme ücreti işlemeden önceki tolerans (dakika).
  latePickupGraceMin     Int      @default(15)
  /// Check-in'de mühür kaydı ZORUNLU mu?
  ///
  /// VARSAYILAN `false` — bilinçli. Lansmanda esnafın elinde mühür olmayabilir ve
  /// `true` yapmak check-in'i tamamen bloke eder. Envanter dağıtıldıktan sonra
  /// `/admin/platform-settings` üzerinden açılır.
  ///
  /// NEDEN GEREKLİ: 2026-08-22'de `BookingSeal` tablosu TAMAMEN BOŞTU, buna
  /// karşılık 3 `CHECKED_IN` rezervasyon vardı — üç bavul dükkanda ama hangi
  /// mühürle mühürlendikleri hiçbir yerde kayıtlı değil. Mühür, anlaşmazlıkta
  /// zilyetliğin kanıtıdır; kaydı yoksa platform hiçbir şey ispat edemez (P1-23).
  requireSealsOnCheckIn  Boolean  @default(false)
  defaultShopCapacity    Int      @default(10)
  defaultPricePerDay     Decimal  @default(50) @db.Decimal(12, 2)
  bagMultiplierS         Decimal  @default(0.8) @db.Decimal(6, 4)
  bagMultiplierM         Decimal  @default(1.0) @db.Decimal(6, 4)
  bagMultiplierXl        Decimal  @default(1.5) @db.Decimal(6, 4)
  updatedAt              DateTime @updatedAt
  /// Platform komisyon oranı (0..1). Esnaf payı = brüt × (1 - bu oran).
  ///
  /// EVİ BURASI, ortam değişkeni DEĞİL. Eskiden `PLATFORM_COMMISSION_RATE`
  /// env'inden okunuyordu ve kaybolduğunda kodda yazılı `0.5`'e SESSİZCE
  /// düşüyordu — yani esnaf, kimse fark etmeden parasının yarısını alırdı.
  /// Burada durunca yönetim arayüzü, önbellek ve audit'i hazır geliyor
  /// (docs/PLATFORM_SETTINGS.md) ve değişiklik iz bırakıyor.
  ///
  /// Varsayılan 0.5, üretimdeki fiilî değerle birebir — bu alanın eklenmesi
  /// hiçbir hesabı değiştirmesin diye.
  platformCommissionRate Decimal  @default(0.5) @db.Decimal(6, 4)

  /// Platform genelinde rezervasyona kapalı takvim günleri (YYYY-MM-DD JSON dizisi).
  platformHolidayDates Json?
}

/// Zamanlanmış iş çalıştırma defteri.
///
/// NEDEN VAR: 2026-08-22 denetiminde iş tanımları üç ayrı yere dağılmıştı ve
/// hiçbiri diğerini bilmiyordu. Sonuç iki kez ısırdı: slot üretimi 37 gün durdu
/// (P0-1) ve ödeme mutabakat cron'u 2 ay boyunca 404 aldı (P1-1b) — ikisi de kimse
/// fark etmeden. Bir işin çalıştığını hiçbir yer KAYDETMİYORDU, dolayısıyla
/// çalışmadığını da kimse söyleyemiyordu.
///
/// Slot üretiminin tazeliği slot ufkundan çıkarılabiliyordu (30 gün ileriye yazıyor,
/// her çalışmadığı gün ufuk 1 kısalıyor) ama bu zekice ve DOLAYLI bir ölçüydü;
/// yalnızca o iş için çalışıyordu. Bu tablo ölçüyü genelleştirir.
model JobRun {
  id         String    @id @default(uuid())
  /// `src/lib/jobs/registry.ts` içindeki iş adı.
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// RUNNING | SUCCESS | FAILED
  status     String    @default("RUNNING")
  durationMs Int?
  /// Başarısızlıkta sebep; başarıda işin kendi özeti (kaç satır üretildi vb.).
  detail     Json?

  @@index([job, startedAt])
  @@index([job, status, finishedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorRole   String
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Birinci taraf, minimal kullanıcı analitiği (sayfa görüntüleme, arama, dükkan
/// görüntüleme, checkout/booking huni adımları). Kişisel veri asgaride: `userId`
/// yalnızca zaten oturum açmış kullanıcı için, IP/User-Agent hiç tutulmuyor.
/// İstemci tarafı olaylar yalnızca çerez onayı verilmişse gönderiliyor
/// (`hasAnalyticsConsent`, `src/lib/plausible-events.ts`).
///
/// Retention: `cleanup` iç işi 90 günden eski kayıtları siler (bkz.
/// `src/lib/jobs/registry.ts`) — tablo sınırsız büyümesin diye.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  /// Sabit sözlük — `src/lib/analytics-events.ts`. Rastgele metin değil.
  name      String
  /// İstemcide üretilip localStorage'da saklanan anonim oturum kimliği.
  sessionId String
  userId    String?
  path      String?
  referrer  String?
  locale    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([sessionId])
  @@index([createdAt])
}

model LegalAcceptance {
  id          String   @id @default(cuid())
  userId      String
  documentKey String
  version     String
  acceptedAt  DateTime @default(now())
  ip          String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentKey])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MobilePushToken {
  token      String   @id
  userId     String
  platform   String // ios, android
  appVersion String?
  locale     String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BlockedIp {
  ip        String   @id
  reason    String?
  createdAt DateTime @default(now())
}

/// Gelen kutusu. İletişim formundan VE `destek@` adresine gelen e-postalardan dolar.
model ContactMessage {
  id               String         @id @default(cuid())
  from             String
  to               String
  subject          String?
  text             String?
  html             String?
  isRead           Boolean        @default(false)
  createdAt        DateTime       @default(now())
  raw              Json?
  /// SUPPORT | BULK | AUTOMATED | UNCLASSIFIED — `src/lib/inbox-classifier.ts`
  ///
  /// NEDEN: 2026-08-22'de kutuda 67 mesaj vardı, 57'si okunmamış ve ezici
  /// çoğunluğu soğuk pazarlamaydı. Gerçek bir misafir şikâyeti bunların arasında
  /// kaybolur — destek kanalının kendisi çalışmıyor demektir (P1-18).
  category         String         @default("UNCLASSIFIED")
  /// Kararı hangi sinyal verdi. Operatör "neden buraya düştü" diye sorabilmeli.
  categoryReason   String?
  /// Gelen postanın RFC Message-ID başlığı — panelden verilen cevabın
  /// `In-Reply-To`/`References` başlıklarıyla aynı yazışma zincirine bağlanması için.
  inboundMessageId String?
  replies          ContactReply[]

  @@index([category, isRead, createdAt])
}

/// Panelden gönderilen destek cevabı. Cevap Resend ile gerçek e-posta olarak gider;
/// bu tablo panelde yazışma geçmişini gösterir ve "cevaplandı mı"nın kaydıdır.
model ContactReply {
  id               String         @id @default(cuid())
  contactMessageId String
  fromEmail        String
  toEmail          String
  subject          String
  body             String
  /// Resend'in dönen e-posta id'si — teslim sorunu izinde kullanılır.
  resendId         String?
  /// Cevabı yazan admin (User.id). İlişki bilerek yok: kullanıcı silinse de kayıt kalmalı.
  sentBy           String
  createdAt        DateTime       @default(now())
  message          ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)

  @@index([contactMessageId, createdAt])
}

model BlogPost {
  id          String   @id @default(uuid())
  locale      String
  slug        String   @unique
  title       String
  content     String
  excerpt     String?
  coverImage  String?
  authorName  String   @default("BagajPark Ekibi")
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locale])
  @@index([isPublished])
}

/// Append-only booking event log — booking'in tüm durum değişikliklerini kaydeder
/// Dispute çözümlerinde booking yaşam döngüsünü kanıtlamak için kullanılır
model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  event     String // CREATED, PAID, CHECKED_IN, CHECKED_OUT, CANCELLED, APPROVED, WAITING_APPROVAL, MODIFIED, DISPUTED, REFUNDED
  actorId   String? // kim yaptı (userId)
  actorRole Role? // GUEST, PARTNER, ADMIN
  metadata  Json? // event-specific data (eski durum, yeni durum, tutar, vs.)
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([bookingId, createdAt])
}

enum Role {
  GUEST
  PARTNER
  ADMIN
}

enum BookingStatus {
  PENDING
  PAID
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  WAITING_APPROVAL
  APPROVED
}

/// Ödeme defteri durumları.
///
/// `PENDING` VARSAYILANDIR ve öyle kalmalı. Önceki varsayılan `SUCCESS` idi; bu,
/// hiçbir kart çekilmeden "başarılı" ödeme kaydı üretilmesine ve prod'da
/// karşılığı olmayan 3.480 TRY'lik deftere yol açtı (2026-08-22 denetimi, P0-0).
enum PaymentStatus {
  /// Niyet açıldı, para henüz alınmadı.
  PENDING
  /// Kart provizyonu alındı ama tahsil edilmedi (3DS/auth-capture akışı).
  AUTHORIZED
  /// Para tahsil edildi.
  SUCCESS
  /// Sağlayıcı reddetti veya tahsilat yapılamadı.
  FAILED
  /// Tamamı iade edildi.
  REFUNDED
  /// Bir kısmı iade edildi; `refundedAmount` ne kadarını söyler.
  PARTIALLY_REFUNDED
  /// Tahsilat yapılmadan niyet kapatıldı (rezervasyon iptali vb.).
  CANCELLED
}

enum SealStatus {
  STOCK
  ASSIGNED
  IN_USE
  RETURNED
  FAULTY
}

/// Esnafın tüzel kimliği — SAĞLAYICIDAN BAĞIMSIZ.
///
/// NEDEN AYRI TABLO: alt üye iş yeri (sub-merchant) onboarding'inde her PSP aynı
/// çekirdek bilgiyi ister — unvan, TCKN veya VKN, vergi dairesi, IBAN. Bunu
/// sağlayıcıya bağlı tutmak, PSP değiştiğinde esnaftan belgeleri BİR KEZ DAHA
/// istemek demektir. Kimlik burada bir kez durur; her sağlayıcı hesabı
/// (`MerchantPaymentAccount`) buna bakar.
model MerchantProfile {
  id        String            @id @default(uuid())
  shopId    String            @unique
  legalType MerchantLegalType

  /// Gerçek kişide ad soyad, şirkette ticari unvan.
  legalName String
  /// Yalnızca INDIVIDUAL için. Checksum doğrulaması `src/lib/tr/identity.ts`.
  tckn      String?
  /// SOLE_PROPRIETORSHIP ve COMPANY için. Checksum aynı modülde.
  vkn       String?
  taxOffice String?

  /// Boşluksuz, büyük harf (`normalizeTrIban`). Hakediş bu hesaba gider.
  iban       String
  /// IBAN sahibinin adı. Unvandan FARKLI olabilir ve PSP'ler bu ikisini
  /// karşılaştırır; ayrı alan olmazsa eşleşmeyen hesap onboarding'de reddedilir.
  ibanHolder String

  addressLine String
  city        String
  district    String?
  phone       String
  email       String

  /// Belge/bilgi doğrulaması insan eliyle yapıldıysa kim ve ne zaman.
  verifiedAt DateTime?
  verifiedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([legalType])
  @@index([verifiedAt])
}

/// Bir dükkanın BİR sağlayıcıdaki alt üye iş yeri hesabı.
///
/// Dükkan × sağlayıcı tekil: aynı dükkan ileride hem iyzico hem PayTR hesabı
/// taşıyabilir, sağlayıcı değişimi eskisini silmeden yapılır.
model MerchantPaymentAccount {
  id       String @id @default(uuid())
  shopId   String
  /// `PaymentProvider.capabilities.id` ile aynı değer ("manual", "iyzico", ...).
  provider String

  /// Sağlayıcının verdiği alt üye iş yeri kimliği. Onboarding tamamlanana dek null.
  providerAccountId String?
  status            MerchantAccountStatus @default(NOT_STARTED)

  /// Sağlayıcı reddettiyse gerekçesi — esnafa ne düzelteceğini söyleyebilmek için.
  rejectionReason String?
  submittedAt     DateTime?
  activatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Profile AYRI bir yabanci anahtarla baglanmiyor. Ayri bir merchantProfileId
  // kolonu, BASKA bir dukkanin profilini gosterebilirdi -- veritabani bunu
  // engelleyemez. Iki kayit da shopId tasidigi icin baglanti zaten tekil ve
  // tutarli: profile `shop.merchantProfile` uzerinden erisilir.
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, provider])
  @@index([provider, status])
  @@index([status])
}

/// Bir ödemenin platform/esnaf paylaşımı — HESAPLANMIŞ DEĞİL, YAZILMIŞ.
///
/// NEDEN TABLO: paylaşım bugün `src/lib/platform-split.ts` içinde her
/// görüntülemede yeniden hesaplanıyor ve hiçbir yere yazılmıyor. İki sonucu var:
///   1. Komisyon oranı değişince GEÇMİŞ hakedişler de değişir — esnafın geçen ay
///      gördüğü tutar bu ay başka çıkar, dayanacak kayıt yoktur.
///   2. Sağlayıcı tarafında split yapıldığında (marketplace) platformun kendi
///      defterinde karşılığı olmaz; mutabakat yapılamaz.
/// Bu yüzden oran da tutarlar da ödeme anında DONDURULUP yazılıyor.
model PaymentSplit {
  id           String @id @default(uuid())
  paymentLogId String @unique
  shopId       String

  grossAmount        Decimal @db.Decimal(12, 2)
  /// Ödeme anındaki oranın ENSTANTANESİ. Ayarı sonradan değiştirmek bu satırı
  /// değiştirmez — geçmiş hakediş sabit kalır.
  commissionRate     Decimal @db.Decimal(6, 4)
  platformCommission Decimal @db.Decimal(12, 2)
  merchantAmount     Decimal @db.Decimal(12, 2)
  currency           String  @default("TRY")

  status      SplitStatus @default(PENDING)
  /// Sağlayıcı split'i kendi tarafında yaptıysa referansı.
  providerRef String?
  settledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentLog PaymentLog @relation(fields: [paymentLogId], references: [id], onDelete: Cascade)
  shop       Shop       @relation(fields: [shopId], references: [id])

  @@index([shopId, status])
  @@index([status])
  @@index([createdAt])
}

enum MerchantLegalType {
  /// Gerçek kişi — TCKN ile. Vergi mükellefiyeti yok.
  INDIVIDUAL
  /// Şahıs şirketi — VKN ile.
  SOLE_PROPRIETORSHIP
  /// Limited / anonim şirket — VKN ile.
  COMPANY
}

enum MerchantAccountStatus {
  /// Esnaf henüz ödeme hesabı bağlamadı.
  NOT_STARTED
  /// Bilgiler sağlayıcıya gönderildi, inceleniyor.
  PENDING
  /// Hakediş alabilir.
  ACTIVE
  /// Sağlayıcı reddetti; `rejectionReason` sebebi tutar.
  REJECTED
  /// Daha önce aktifti, askıya alındı.
  SUSPENDED
}

enum SplitStatus {
  /// Ödeme alındı, paylaşım henüz esnafa geçmedi.
  PENDING
  /// Esnaf payı sağlayıcı tarafından aktarıldı.
  SETTLED
  /// İade sonrası paylaşım geri alındı.
  REVERSED
}

/// Talep testi noktasina birakilan "acilinca haber ver" kaydi.
///
/// Bu tablo, `Shop.isPrelaunch` noktalarinin TEK ciktisidir: bir kisi orada
/// rezervasyon yapmaya kalkisti ve haberdar edilmek istedi. Tiklamadan daha
/// guclu bir sinyaldir -- kisi niyetini beyan etmistir -- ve sehir acildiginda
/// hazir talep listesi olur.
/// Talep testi noktasina birakilan TEK TIKLIK istek.
///
/// NEDEN `PrelaunchInterest` YETMIYOR: o kayit e-posta ISTIYOR ve e-posta
/// birakmak yuksek surtunmeli bir adim. Olcmek istedigimiz ilk soru daha ucuz:
/// "burada bir nokta olsun mu?" Tek tik bunu sorar; e-posta bir adim otesidir ve
/// ikisi AYRI sinyaldir -- biri ilgi genisligini, digeri niyet derinligini olcer.
/// Ikisini ayni tabloda toplamak, e-postasiz kayitlari sahte e-postalarla
/// doldurmak ya da benzersizligi kaybetmek anlamina gelirdi.
///
/// `anonId` HTTP-only bir cerezde tasinan rastgele kimliktir; kisiyi tanimlamaz,
/// yalnizca ayni tarayicinin sayiyi sisirmesini engeller. Karar bu sayiya
/// bakilarak verildigi icin dedupe veritabani seviyesinde tutulur -- istemciye
/// birakilan bir kontrol, konsoldan gecilebilecek bir kontroldur.
model PrelaunchWant {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// Cerezdeki anonim tarayici kimligi. Kisisel veri degil, sayac dedupe anahtari.
  anonId    String
  locale    String?
  /// Kayit hangi yoldan geldi: "web" | "mobile".
  source    String   @default("web")
  createdAt DateTime @default(now())

  /// Ayni tarayici ayni noktayi iki kez isteyemez.
  @@unique([shopId, anonId])
  @@index([shopId, createdAt])
  @@index([createdAt])
}

model PrelaunchInterest {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  email     String
  locale    String?
  /// Kayit hangi yoldan geldi: "web" | "mobile".
  source    String   @default("web")
  createdAt DateTime @default(now())

  /// Ayni kisi ayni noktaya iki kez kaydolmasin; ilgi SAYISI sisirilmemeli.
  @@unique([shopId, email])
  @@index([shopId, createdAt])
  @@index([createdAt])
}
